# Google Gemini API key — used ONLY server-side by the AI assistant.
# Get one at https://aistudio.google.com/apikey
# Copy this file to .env.local and paste your key there.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional: remove.bg API key for the "Remove BG" filter (needs their service)
# REMOVE_BG_API_KEY=